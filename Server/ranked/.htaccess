# The settings, shared code and any local database file are never served directly.
<FilesMatch "^(config\.php|config\.example\.php|lib\.php|.*\.sqlite|README\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
